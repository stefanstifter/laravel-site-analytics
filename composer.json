{
    "name": "stifter/site-analytics",
    "description": "Minimal, privacy-friendly site analytics for Laravel apps.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "jaybizzle/crawler-detect": "^1.3"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Stifter\\SiteAnalytics\\": "src/",
            "Stifter\\SiteAnalytics\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stifter\\SiteAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stifter\\SiteAnalytics\\SiteAnalyticsServiceProvider"
            ],
            "aliases": {
                "SiteAnalytics": "Stifter\\SiteAnalytics\\Facades\\SiteAnalytics"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
